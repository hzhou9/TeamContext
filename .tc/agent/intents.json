{
  "command_only_opt_out": "Only skip execution when user explicitly asks for command-only output.",
  "default_mode": "execute",
  "rules": [
    {
      "command": [
        "tc",
        "agent",
        "save",
        "--changes-source",
        "uncommitted",
        "--auto-bootstrap-if-empty",
        "--intent",
        "<intent-delta>",
        "--decisions",
        "<decisions>"
      ],
      "execute_immediately": true,
      "intent": "save recent context to tc"
    },
    {
      "command": [
        "tc",
        "agent",
        "save",
        "--changes-source",
        "uncommitted",
        "--auto-bootstrap-if-empty",
        "--intent",
        "<intent-delta>",
        "--decisions",
        "<decisions>"
      ],
      "execute_immediately": true,
      "intent": "save context"
    },
    {
      "command": [
        "tc",
        "sync",
        "--json"
      ],
      "execute_immediately": true,
      "intent": "sync latest context"
    },
    {
      "command": [
        "tc",
        "sync",
        "--json"
      ],
      "execute_immediately": true,
      "intent": "sync context"
    }
  ],
  "version": 1
}
